<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".Fragments.OtherFragments.WeatherFragments.FiveDayForecastFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/forecast_outer_bg"
        android:padding="10dp"
        android:layout_margin="12dp"
        android:weightSum="5">

        <!-- Day 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/forecast_day_bg"
            android:layout_marginEnd="4dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/dayLabel1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:layout_marginBottom="8dp" />

            <ImageView
                android:id="@+id/day1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/sun"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tempDay1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0° / 0°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Day 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/forecast_day_bg"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/dayLabel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:layout_marginBottom="8dp" />

            <ImageView
                android:id="@+id/day2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/sun"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tempDay2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0° / 0°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Day 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/forecast_day_bg"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/dayLabel3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:layout_marginBottom="8dp" />

            <ImageView
                android:id="@+id/day3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/sun"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tempDay3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0° / 0°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Day 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/forecast_day_bg"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/dayLabel4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:layout_marginBottom="8dp" />

            <ImageView
                android:id="@+id/day4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/sun"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tempDay4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0° / 0°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Day 5 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/forecast_day_bg"
            android:layout_marginStart="4dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/dayLabel5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:layout_marginBottom="8dp" />

            <ImageView
                android:id="@+id/day5"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/sun"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tempDay5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0° / 0°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>