<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F8F8">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#E6E6E6"
        android:paddingHorizontal="12dp">

        <!-- Search box -->
        <EditText
            android:id="@+id/searchChallenges"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/sortSpinner"
            android:layout_marginEnd="8dp"
            android:background="@drawable/rounded_corners_container"
            android:hint="Search challenges..."
            android:textSize="13sp"
            android:textColorHint="#B0B0B0"
            android:textColor="#1A1A1A"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

        <!-- Sort dropdown -->
        <Spinner
            android:id="@+id/sortSpinner"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/rounded_corners_container" />

    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active Challenges"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/challenges_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

</LinearLayout>