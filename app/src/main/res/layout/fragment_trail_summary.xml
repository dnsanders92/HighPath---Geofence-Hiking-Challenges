<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".Fragments.OtherFragments.TrailSummaryFragment">

    <ImageButton
        android:id="@+id/trailMapImage"
        android:layout_width="match_parent"
        android:layout_height="204dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/gpx_track_sample" />

    <TextView
        android:id="@+id/trailName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        tools:text="Trail Name" />

    <TextView
        android:id="@+id/trailRegion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#666666"
        tools:text="Region" />

    <TextView
        android:id="@+id/trailDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Distance: 12.5 km" />

    <TextView
        android:id="@+id/trailAscent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Ascent: 450 m" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track Points:"
        android:textStyle="italic"
        android:layout_marginTop="16dp" />

    <ListView
        android:id="@+id/trailPointsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="0.5dp" />

</LinearLayout>