<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="36dp">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:text="⛰"
                android:textSize="38sp"
                android:background="@drawable/circle_accent_bg"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="#121212"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start your summit journey"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <!-- ── SECTION: Account Credentials ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT CREDENTIALS"
            android:textColor="#0F6E56"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="Email Address"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:boxBackgroundColor="#FCFCFC"
            app:hintTextColor="#9E9E9E"
            app:errorTextColor="#D32F2F"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registerEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="Password"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:boxBackgroundColor="#FCFCFC"
            app:hintTextColor="#9E9E9E"
            app:errorTextColor="#D32F2F"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#9E9E9E"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/registerPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password strength indicator -->
        <LinearLayout
            android:id="@+id/passwordStrengthContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <View
                android:id="@+id/strengthBar1"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E0E0E0"
                android:backgroundTint="#E0E0E0" />

            <View
                android:id="@+id/strengthBar2"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#E0E0E0" />

            <View
                android:id="@+id/strengthBar3"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="#E0E0E0" />

            <TextView
                android:id="@+id/strengthLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weak"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- Confirm Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirmPasswordLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"
            android:hint="Confirm Password"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:boxBackgroundColor="#FCFCFC"
            app:hintTextColor="#9E9E9E"
            app:errorTextColor="#D32F2F"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#9E9E9E"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── SECTION: Personal Info ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERSONAL INFO"
            android:textColor="#0F6E56"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <!-- First Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/firstNameLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="First Name"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:boxBackgroundColor="#FCFCFC"
            app:hintTextColor="#9E9E9E"
            app:errorTextColor="#D32F2F"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/firstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Surname -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/surnameLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:hint="Surname"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:boxBackgroundColor="#FCFCFC"
            app:hintTextColor="#9E9E9E"
            app:errorTextColor="#D32F2F"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/surname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── SECTION: Date of Birth ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATE OF BIRTH"
            android:textColor="#0F6E56"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <!-- Birth Month Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/birthMonthLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="Month"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:boxBackgroundColor="#FCFCFC"
            app:hintTextColor="#9E9E9E"
            app:errorTextColor="#D32F2F"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <AutoCompleteTextView
                android:id="@+id/birthMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:dropDownHeight="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Birth Year -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/birthYearLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:hint="Year (e.g. 1995)"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:boxBackgroundColor="#FCFCFC"
            app:hintTextColor="#9E9E9E"
            app:errorTextColor="#D32F2F"
            app:counterEnabled="true"
            app:counterMaxLength="4"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/birthYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Register Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/completeRegisterButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Create Account"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="#0F6E56"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            android:stateListAnimator="@null" />

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#F0F0F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Already have an account?  "
                android:textColor="#B0B0B0"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#F0F0F0" />

        </LinearLayout>

        <!-- Sign In secondary button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/goToLoginButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Sign In"
            android:textColor="#0F6E56"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="#F0F0F0"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>