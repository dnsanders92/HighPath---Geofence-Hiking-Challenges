<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragments.NavigationFragments.ProfileFragment">

    <!-- TOP FRAME -->
    <FrameLayout
        android:id="@+id/topFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F2F0F0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomFrame"
        app:layout_constraintVertical_weight="0.45">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Banner + Circle -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="6"
                android:background="#F2F0F0">

                <ImageView
                    android:id="@+id/bannerImage"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profileImage"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:padding="5dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleImageStyle"
                        app:strokeColor="#3A3A3A"
                        app:strokeWidth="5dp" />

                </LinearLayout>
            </FrameLayout>

            <!-- Username -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/labelUserName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="User Name"
                    android:textSize="34dp"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- BOTTOM FRAME -->
    <FrameLayout
        android:id="@+id/bottomFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F2F0F0"
        app:layout_constraintTop_toBottomOf="@id/topFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_weight="0.55">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- ROW 1: Total Distance + Total Elevation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <!-- TOTAL DISTANCE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_corners_container"
                    android:backgroundTint="#E6E6E6"
                    android:layout_marginEnd="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:text="TOTAL DISTANCE (km)"
                        android:textSize="11dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/labelTotalDistance"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:text="0"
                        android:textSize="30dp" />

                </LinearLayout>

                <!-- TOTAL ELEVATION -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_corners_container"
                    android:backgroundTint="#E6E6E6"
                    android:layout_marginStart="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:text="TOTAL ELEVATION (m)"
                        android:textSize="11dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/labelTotalElevation"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:text="0"
                        android:textSize="30dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ROW 2: Longest Distance + Most Elevation Gain (MOVED UP) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <!-- LONGEST DISTANCE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_corners_container"
                    android:backgroundTint="#E6E6E6"
                    android:layout_marginEnd="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:text="LONGEST DISTANCE (km)"
                        android:textSize="11dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/labelLongestDistance"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:text="0"
                        android:textSize="30dp" />

                </LinearLayout>

                <!-- MOST ELEVATION GAIN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_corners_container"
                    android:backgroundTint="#E6E6E6"
                    android:layout_marginStart="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:text="MOST ELEVATION GAIN (m)"
                        android:textSize="11dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/labelMostElevationGain"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:text="0"
                        android:textSize="30dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ROW 3: Completed Activities + Completed Challenges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_corners_container"
                    android:backgroundTint="#E6E6E6"
                    android:layout_marginEnd="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:text="COMPLETED ACTIVITIES"
                        android:textSize="11dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/labelCompletedActivities"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:text="0"
                        android:textSize="30dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_corners_container"
                    android:backgroundTint="#E6E6E6"
                    android:layout_marginStart="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:text="COMPLETED CHALLENGES"
                        android:textSize="11dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/labelCompletedChallenges"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:text="0"
                        android:textSize="30dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ROW 4: Total Time Outside + Total Moving Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/rounded_corners_container"
                android:backgroundTint="#E6E6E6">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:text="TOTAL TIME OUTSIDE"
                        android:textSize="11dp"
                        android:layout_marginStart="10dp" />

                    <TextView
                        android:id="@+id/labelTimeOutside"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:text="00:00:00"
                        android:textSize="25dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:text="TOTAL MOVING TIME"
                        android:textSize="11dp"
                        android:layout_marginStart="10dp" />

                    <TextView
                        android:id="@+id/labelMovingTime"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:text="00:00:00"
                        android:textSize="25dp" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
