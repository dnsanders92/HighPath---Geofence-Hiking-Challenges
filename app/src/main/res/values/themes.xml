<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HighPath" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->

        <!-- 1. Force Status Bar to Black -->
        <item name="android:statusBarColor">#000000</item>

        <!-- 2. Ensure icons are white (light) so they are visible on black -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Existing Customizations -->
        <item name="colorSecondaryContainer">@android:color/transparent</item>
        <item name="colorOnSecondaryContainer">@android:color/black</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <style name="CircleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.HighPath" parent="Base.Theme.HighPath" />
</resources>