<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp">

    <!-- Blue rounded container -->
    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:background="@drawable/rounded_corners_container"
        android:layout_margin="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- SECTION 1 (half height) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/section1"
            android:layout_width="match_parent"
            android:layout_height="120dp" >

            <ImageView
                android:id="@+id/section1Image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rounded_corners"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/default_banner_image"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/default_banner_image" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SECTION 2 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/section2"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="120dp" >

            <TextView
                android:id="@+id/activityName"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="Activity Name"
                android:textSize="20dp"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:gravity="center_vertical|start"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- SECTION 3 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/section3"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="160dp">

            <!-- BOX 1 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/box1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/box2"
                app:layout_constraintWidth_percent="0.25">

                <TextView
                    android:id="@+id/box1Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Distance"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BOX 2 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/box2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toEndOf="@id/box1"
                app:layout_constraintEnd_toStartOf="@id/box3"
                app:layout_constraintWidth_percent="0.25">

                <TextView
                    android:id="@+id/box2Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Elevation"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BOX 3 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/box3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toEndOf="@id/box2"
                app:layout_constraintEnd_toStartOf="@id/box4"
                app:layout_constraintWidth_percent="0.25">

                <TextView
                    android:id="@+id/box3Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BOX 4 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/box4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toEndOf="@id/box3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.25">

                <TextView
                    android:id="@+id/box4Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- SECTION 4 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/section4"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="200dp">

            <!-- BOX 1 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/box1_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/box2_value"
                app:layout_constraintWidth_percent="0.25">

                <TextView
                    android:id="@+id/activityDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 km"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BOX 2 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/box2_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toEndOf="@id/box1_value"
                app:layout_constraintEnd_toStartOf="@id/box3_value"
                app:layout_constraintWidth_percent="0.25">

                <TextView
                    android:id="@+id/activityElevation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 m"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BOX 3 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/box3_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toEndOf="@id/box2_value"
                app:layout_constraintEnd_toStartOf="@id/box4_value"
                app:layout_constraintWidth_percent="0.25">

                <TextView
                    android:id="@+id/activityTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BOX 4 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/box4_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintStart_toEndOf="@id/box3_value"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.25">

                <TextView
                    android:id="@+id/activityDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
