<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="8dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- METRICS GRID -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="false"
        android:alignmentMode="alignBounds">

        <!-- DISTANCE (left) -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="start"
            android:paddingVertical="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill">

            <TextView
                android:id="@+id/labelDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 km"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/labelDistanceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distance"
                android:textColor="#AAAAAA"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- PACE (right) -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="start"
            android:paddingVertical="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/labelPace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/labelPaceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pace"
                android:textColor="#AAAAAA"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ELEVATION (left) -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="start"
            android:paddingVertical="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill">

            <TextView
                android:id="@+id/labelElevationGain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 m"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/labelElevationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elevation Gain"
                android:textColor="#AAAAAA"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- TIME (right) -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="start"
            android:paddingVertical="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/labelTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/labelTimeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time"
                android:textColor="#AAAAAA"
                android:textSize="11sp" />
        </LinearLayout>

    </GridLayout>

    <!-- BUTTONS ROW -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="6dp"
            android:text="Start"
            android:backgroundTint="#66BB6A" />


        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="0dp"
            android:text="Stop"
            android:backgroundTint="#F44336" />


    </LinearLayout>

</LinearLayout>
